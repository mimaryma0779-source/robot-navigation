            continuer = False

        elif evenement.type == pygame.KEYDOWN:
            if evenement.key in (pygame.K_F1, pygame.K_F2, pygame.K_F3, pygame.K_F4):
                action_panneau("algo%d" % (evenement.key - pygame.K_F1))
            elif evenement.key in (pygame.K_SPACE, pygame.K_RETURN, pygame.K_KP_ENTER):
                appuyer_bouton()
            elif evenement.key == pygame.K_d:
                action_panneau("diag")
            elif evenement.key == pygame.K_c:
                action_panneau("comparer")
            elif evenement.key == pygame.K_e:
                action_panneau("zone")
            elif evenement.key == pygame.K_m:
                montrer_matrice = not montrer_matrice
            elif evenement.key == pygame.K_r:
                action_panneau("alea")
            elif evenement.key == pygame.K_UP:
                action_panneau("plus")
            elif evenement.key == pygame.K_DOWN:
                action_panneau("moins")
            elif evenement.key == pygame.K_RIGHT:
                action_panneau("c_plus")
            elif evenement.key == pygame.K_LEFT:
                action_panneau("c_moins")
            elif evenement.key == pygame.K_PAGEUP:
                action_panneau("l_plus")
            elif evenement.key == pygame.K_PAGEDOWN:
                action_panneau("l_moins")

        elif evenement.type == pygame.MOUSEBUTTONDOWN and evenement.button == 1:
            pos_clic = vers_logique(evenement.pos)
            # ----- Bouton principal -----
            if bouton.collidepoint(pos_clic):
                appuyer_bouton()

            # ----- Panneau de droite -----
            elif pos_clic[0] >= LARGEUR_ZONE and pos_clic[1] < HAUTEUR_ZONE:
                for nom, zone in boutons_panneau.items():
                    if zone.collidepoint(pos_clic):
                        action_panneau(nom)
                        break

            # ----- Clic sur la grille : ajouter / retirer un meuble -----
            elif 0 <= pos_clic[0] < LARGEUR_PIX and 0 <= pos_clic[1] < HAUTEUR_PIX:
                colonne = pos_clic[0] // TAILLE_CASE
                ligne = pos_clic[1] // TAILLE_CASE
                case = (ligne, colonne)

                protegees = {depart, prise}
                if etat in ("en_route", "coince"):
                    a, b = chemin[index - 1], chemin[index]
                    protegees.update([a, b])
                    if a[0] != b[0] and a[1] != b[1]:   # segment diagonal en cours
                        protegees.update([(a[0], b[1]), (b[0], a[1])])

                if case not in protegees:
                    grille[ligne][colonne] = 1 - grille[ligne][colonne]
                    est_obstacle = (grille[ligne][colonne] == 1)
                    comparaison = []

                    if etat in ("attente", "arrive"):
                        reinitialiser()

                    elif etat in ("en_route", "coince"):
                        quittee = chemin[index - 1]
                        visee = chemin[index]
                        coupe = not chemin_valide(chemin, index)

                        if coupe or etat == "coince":
                            # Le chemin est coupé (ou le robot est bloqué) : recalcul obligatoire
                            res = rechercher(algo, visee, prise, diagonales, limite_ms())
                            if res["statut"] != "aucun":
                                remplacer_trajet(res, quittee)
                                etat = "en_route"
                            else:
                                appliquer_resultat(res)
                                etat = "coince"
                        elif not est_obstacle:
                            # Un meuble a disparu : un chemin plus court existe peut-être
                            res = rechercher(algo, visee, prise, diagonales, limite_ms())
                            if res["statut"] != "aucun":
                                reste = cout_chemin(chemin[index:])
                                chemin_incomplet = chemin[-1] != prise
                                meilleur = (res["statut"] == "ok"
                                            and res["cout"] < reste - 1e-9)
                                if meilleur or (chemin_incomplet and res["statut"] == "ok"):
                                    remplacer_trajet(res, quittee)

    # --- Déplacement du robot ---
    if etat == "en_route":
        cible_x = chemin[index][1] * TAILLE_CASE
        cible_y = chemin[index][0] * TAILLE_CASE
        dx = cible_x - robot_x
        dy = cible_y - robot_y
        distance = (dx ** 2 + dy ** 2) ** 0.5
        if distance <= VITESSE:
            robot_x, robot_y = cible_x, cible_y
            index += 1
            if index >= len(chemin):
                if chemin[-1] == prise:
                    etat = "arrive"
                else:
                    # Chemin partiel (temps dépassé) : on recalcule depuis ici
                    res = rechercher(algo, chemin[-1], prise, diagonales, limite_ms())
                    if res["statut"] != "aucun" and len(res["chemin"]) > 1:
                        remplacer_trajet(res, chemin[-1])
                    else:
                        appliquer_resultat(res)
                        etat = "coince"
        else:
            robot_x += VITESSE * dx / distance
            robot_y += VITESSE * dy / distance

    # --- Dessin de la grille ---
    fenetre.fill(FOND)
    for ligne in range(nb_lignes):
        for colonne in range(nb_colonnes):
            x = colonne * TAILLE_CASE
            y = ligne * TAILLE_CASE
            if grille[ligne][colonne] == 1:
                dessiner_sol(fenetre, x, y, ligne, colonne)
                dessiner_meuble(fenetre, x, y)
            else:
                dessiner_sol(fenetre, x, y, ligne, colonne)

    if montrer_zone and zone_explorée:
        voile = pygame.Surface((TAILLE_CASE, TAILLE_CASE), pygame.SRCALPHA)
        voile.fill((60, 200, 140, 70))
        for (l, c) in zone_explorée:
            if grille[l][c] == 0:
                fenetre.blit(voile, (c * TAILLE_CASE, l * TAILLE_CASE))

    dessiner_lignes_grille(fenetre)

    if montrer_matrice:
        dessiner_matrice(fenetre, police_petite_gras)

    if etat in ("attente", "en_route") and chemin:
        points = [(int(robot_x + TAILLE_CASE / 2), int(robot_y + TAILLE_CASE / 2))]
        for (l, c) in chemin[index:]:
            points.append(centre_case(l, c))
        partiel = chemin[-1] != prise
        dessiner_chemin(fenetre, points, CHEMIN_PARTIEL if partiel else CHEMIN)

    dessiner_prise(fenetre, prise[1] * TAILLE_CASE, prise[0] * TAILLE_CASE)
    dessiner_robot(fenetre, robot_x, robot_y)

    # --- Panneau de droite ---
    pygame.draw.rect(fenetre, PANNEAU, rect(LARGEUR_ZONE, 0, LARGEUR_PANNEAU, HAUTEUR_ZONE))
    fenetre.blit(police_petite_gras.render("Algorithme (F1 à F4)", True, TEXTE), (PX, DEC + 8))
    for i in range(4):
        couleur = BOUTON_ACTIF if algo == i else BOUTON_PANNEAU
        dessiner_bouton(fenetre, police_petite, boutons_panneau["algo%d" % i], NOMS_ALGOS[i], couleur)
    dessiner_bouton(fenetre, police_petite, boutons_panneau["diag"],
                    "Diagonales (D) : " + ("oui" if diagonales else "non"), BOUTON_PANNEAU)
    dessiner_bouton(fenetre, police_petite, boutons_panneau["zone"],
                    "Cases explorées (E) : " + ("oui" if montrer_zone else "non"), BOUTON_PANNEAU)
    dessiner_bouton(fenetre, police_petite, boutons_panneau["comparer"], "Comparer (C)", BOUTON_PANNEAU)
    dessiner_bouton(fenetre, police_petite, boutons_panneau["alea"], "Aléatoire (R)", BOUTON_PANNEAU)

    fenetre.blit(police_petite.render("Limite de calcul : %s ms" % limite_ms(), True, TEXTE), (PX, Y_LIMITE + 5))
    dessiner_bouton(fenetre, police_petite, boutons_panneau["moins"], "-", BOUTON_PANNEAU)
    dessiner_bouton(fenetre, police_petite, boutons_panneau["plus"], "+", BOUTON_PANNEAU)

    # Réglages de la grille
    fenetre.blit(police_petite.render("Lignes : %d" % nb_lignes, True, TEXTE), (PX, Y_LIGNES + 5))
    dessiner_bouton(fenetre, police_petite, boutons_panneau["l_moins"], "-", BOUTON_PANNEAU)
    dessiner_bouton(fenetre, police_petite, boutons_panneau["l_plus"], "+", BOUTON_PANNEAU)
    fenetre.blit(police_petite.render("Colonnes : %d" % nb_colonnes, True, TEXTE), (PX, Y_COLONNES + 5))
    dessiner_bouton(fenetre, police_petite, boutons_panneau["c_moins"], "-", BOUTON_PANNEAU)
    dessiner_bouton(fenetre, police_petite, boutons_panneau["c_plus"], "+", BOUTON_PANNEAU)
    fenetre.blit(police_petite.render("Meubles : %d %%" % densite_pct, True, TEXTE), (PX, Y_DENSITE + 5))
    dessiner_bouton(fenetre, police_petite, boutons_panneau["d_moins"], "-", BOUTON_PANNEAU)
    dessiner_bouton(fenetre, police_petite, boutons_panneau["d_plus"], "+", BOUTON_PANNEAU)

    y = DEC + 318
    fenetre.blit(police_petite_gras.render("Dernière recherche", True, TEXTE), (PX, y))
    if stats:
        lignes = [
            "Statut : %s" % stats["statut"],
            "Temps : %.3f ms" % stats["temps"],
            "Longueur : %.2f" % stats["cout"],
            "Cases explorées : %d" % stats["explores"],
        ]
        for k, texte in enumerate(lignes):
            fenetre.blit(police_petite.render(texte, True, TEXTE_DISCRET), (PX, y + 18 + k * 16))

    y = DEC + 412
    if comparaison:
        fenetre.blit(police_petite_gras.render("Comparaison (départ -> prise)", True, TEXTE), (PX, y))
        fenetre.blit(police_petite.render("Algo     ms      long.   expl.", True, TEXTE_DISCRET), (PX, y + 18))
        for k, (nom, t, c, e, s) in enumerate(comparaison):
            ligne_txt = "%-8s %-7.3f %-7.2f %d%s" % (nom, t, c, e, "" if s == "ok" else " (%s)" % s)
            fenetre.blit(police_petite.render(ligne_txt, True, TEXTE), (PX, y + 36 + k * 16))
    else:
        fenetre.blit(police_petite.render("Clic sur la grille : meuble", True, TEXTE_DISCRET), (PX, y))
        fenetre.blit(police_petite.render("Violet = chemin partiel (temps dépassé)", True, TEXTE_DISCRET), (PX, y + 18))
        fenetre.blit(police_petite.render("M : afficher la matrice (0 / 1)", True, TEXTE_DISCRET), (PX, y + 36))
        fenetre.blit(police_petite.render("Meubles % : appliqué par « Aléatoire »", True, TEXTE_DISCRET), (PX, y + 54))
        fenetre.blit(police_petite.render("Flèches gauche/droite : colonnes", True, TEXTE_DISCRET), (PX, y + 72))
        fenetre.blit(police_petite.render("Page haut/bas : lignes", True, TEXTE_DISCRET), (PX, y + 90))

    # --- Barre du bas ---
    if etat == "attente":
        if len(chemin) > 1:
            if chemin[-1] != prise:
                message = "Chemin partiel (temps dépassé)"
            else:
                message = "Prêt : Démarrer (ou Espace)"
            texte_bouton, actif = "Démarrer", True
        else:
            message, texte_bouton, actif = "La prise est inaccessible", "Démarrer", False
    elif etat == "en_route":
        message, texte_bouton, actif = "Le robot cherche sa prise...", "En cours...", False
    elif etat == "coince":
        message, texte_bouton, actif = "Chemin bloqué !", "Recommencer", True
    else:
        message, texte_bouton, actif = "Branché ! Batterie en charge", "Recommencer", True

    fenetre.blit(police_petite_gras.render(message, True, TEXTE), (PX, 6))
    survol = actif and bouton.collidepoint(souris)
    couleur = BOUTON_GRIS if not actif else (BOUTON_SURVOL if survol else BOUTON)
    dessiner_bouton(fenetre, police, bouton, texte_bouton, couleur)

    ecran, echelle, decalage, taille = geometrie_affichage()
    ecran.fill((0, 0, 0))
    if taille == (LARGEUR, HAUTEUR):
        ecran.blit(fenetre, decalage)
    else:
        ecran.blit(pygame.transform.smoothscale(fenetre, taille), decalage)
    pygame.display.flip()
    horloge.tick(60)

pygame.quit()

