def limite_ms():
    return LIMITES_MS[indice_limite]


def appliquer_resultat(res):
    """Mémorise le résultat d'une recherche pour l'affichage."""
    global stats, zone_explorée
    stats = res
    zone_explorée = res["zone"]


def reinitialiser():
    """Remet le robot au départ et recalcule le chemin."""
    global etat, chemin, index, robot_x, robot_y
    robot_x = depart[1] * TAILLE_CASE
    robot_y = depart[0] * TAILLE_CASE
    res = rechercher(algo, depart, prise, diagonales, limite_ms())
    appliquer_resultat(res)
    chemin = res["chemin"] if res["statut"] != "aucun" else []
    index = 1
    etat = "attente"


def remplacer_trajet(res, quittee):
    """Adopte un nouveau trajet : [case quittée] + chemin trouvé depuis la case visée."""
    global chemin, index
    appliquer_resultat(res)
    chemin = [quittee] + res["chemin"]
    index = 1


def meubles_aleatoires():
    for l in range(nb_lignes):
        for c in range(nb_colonnes):
            if (l, c) in (depart, prise):
                grille[l][c] = 0
            else:
                grille[l][c] = 1 if random.random() < densite_pct / 100 else 0


def redimensionner(nouvelles_lignes, nouvelles_colonnes):
    """Change la taille de la grille : garde les meubles existants,
    remplit les nouvelles cases au hasard, et adapte la taille des cases."""
    global nb_lignes, nb_colonnes, grille, prise
    nouvelles_lignes = max(MIN_TAILLE, min(MAX_TAILLE, nouvelles_lignes))
    nouvelles_colonnes = max(MIN_TAILLE, min(MAX_TAILLE, nouvelles_colonnes))
    if (nouvelles_lignes, nouvelles_colonnes) == (nb_lignes, nb_colonnes):
        return

    ancienne = grille
    anciennes_lignes, anciennes_colonnes = nb_lignes, nb_colonnes
    nb_lignes, nb_colonnes = nouvelles_lignes, nouvelles_colonnes

    grille = []
    for l in range(nb_lignes):
        ligne = []
        for c in range(nb_colonnes):
            if l < anciennes_lignes and c < anciennes_colonnes:
                ligne.append(ancienne[l][c])
            else:
                ligne.append(1 if random.random() < densite_pct / 100 else 0)
        grille.append(ligne)

    prise = (nb_lignes - 1, nb_colonnes - 1)
    grille[depart[0]][depart[1]] = 0
    grille[prise[0]][prise[1]] = 0

    calculer_dimensions()
    print("Grille : %d lignes x %d colonnes (cases de %d px)" % (nb_lignes, nb_colonnes, TAILLE_CASE))


def action_panneau(nom):
    global algo, diagonales, montrer_zone, indice_limite, comparaison, densite_pct
    if nom == "zone":
        montrer_zone = not montrer_zone
        return
    if nom == "comparer":
        comparaison = comparer_algos(depart, prise, diagonales, limite_ms())
        return
    if etat == "en_route":
        return   # on ne change pas la configuration pendant le déplacement
    if nom == "d_moins":     # la densité sera utilisée par « Aléatoire » (R)
        densite_pct = max(0, densite_pct - 5)
        return
    if nom == "d_plus":
        densite_pct = min(40, densite_pct + 5)
        return
    if nom.startswith("algo"):
        algo = int(nom[4])
    elif nom == "diag":
        diagonales = not diagonales
    elif nom == "moins":
        indice_limite = max(0, indice_limite - 1)
    elif nom == "plus":
        indice_limite = min(len(LIMITES_MS) - 1, indice_limite + 1)
    elif nom == "alea":
        meubles_aleatoires()
    elif nom == "l_moins":
        redimensionner(nb_lignes - 1, nb_colonnes)
    elif nom == "l_plus":
        redimensionner(nb_lignes + 1, nb_colonnes)
    elif nom == "c_moins":
        redimensionner(nb_lignes, nb_colonnes - 1)
    elif nom == "c_plus":
        redimensionner(nb_lignes, nb_colonnes + 1)
    comparaison = []
    reinitialiser()


def appuyer_bouton():
    """Action du bouton Démarrer / Recommencer (aussi : Espace ou Entrée)."""
    global etat, index
    if etat == "attente":
        if len(chemin) > 1:
            etat = "en_route"
            index = 1
    elif etat in ("arrive", "coince"):
        reinitialiser()


meubles_aleatoires()
reinitialiser()

