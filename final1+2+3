def geometrie_affichage():
    """Écran réel, échelle, décalage et taille de la toile affichée."""
    ecran = pygame.display.get_surface()
    ew, eh = ecran.get_size()
    echelle = min(ew / LARGEUR, eh / HAUTEUR)
    w, h = max(1, int(LARGEUR * echelle)), max(1, int(HAUTEUR * echelle))
    return ecran, echelle, ((ew - w) // 2, (eh - h) // 2), (w, h)


def vers_logique(pos):
    """Convertit une position de souris (fenêtre réelle) en position sur la toile."""
    _, echelle, (ox, oy), _ = geometrie_affichage()
    return (int((pos[0] - ox) / echelle), int((pos[1] - oy) / echelle))


