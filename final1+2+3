def dessiner_matrice(fenetre, police):
    """Écrit 0 (libre) ou 1 (meuble) au centre de chaque case."""
    for l in range(nb_lignes):
        for c in range(nb_colonnes):
            valeur = grille[l][c]
            couleur = (255, 255, 255) if valeur == 1 else COULEUR_MATRICE
            image = police.render(str(valeur), True, couleur)
            centre = (c * TAILLE_CASE + TAILLE_CASE // 2, l * TAILLE_CASE + TAILLE_CASE // 2)
            fenetre.blit(image, image.get_rect(center=centre))


